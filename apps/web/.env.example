# 국가법령정보센터 Open API 키 (https://open.law.go.kr)
LAW_OC=
# MCP 엔드포인트 보호용 공유 시크릿 (32자 이상 랜덤 권장)
MCP_SHARED_SECRET=
# Supabase 프로젝트 (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# P2: Managed Agents 실행 코어
ANTHROPIC_API_KEY=
# 에이전트가 MCP 엔드포인트에 도달할 공개 URL (예: Vercel 배포 도메인, 끝 슬래시 없이)
APP_PUBLIC_URL=
# 실행 에이전트 모델 (기본 claude-sonnet-5)
ANTHROPIC_AGENT_MODEL=
